@model IEnumerable<test1.Models.Cliente>

@{
    ViewData["Title"] = "Clientes";
}

<section class="clientes-hero rounded-4 p-4 p-md-5 mb-4 text-white">
    <div class="row align-items-center g-3">
        <div class="col-md">
            <span class="badge text-bg-light text-primary mb-2">SEMANA TRES · TAREA 1</span>
            <h1 class="display-6 fw-bold mb-2">Tarea Aplicaciones Web</h1>
            <p class="mb-1 opacity-75">Alumno: Danny Ricardo Macias Alvarado</p>
            <p class="mb-0 opacity-75">Administración del directorio de clientes.</p>
        </div>
        <div class="col-md-auto">
            <a asp-action="Create" class="btn btn-light btn-lg text-primary fw-semibold">Registrar cliente</a>
        </div>
    </div>
</section>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="card-header bg-white border-0 px-4 pt-4 pb-2">
        <h2 class="h5 mb-1">Clientes registrados</h2>
        <p class="text-secondary small mb-0">@Model.Count() registro(s)</p>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">@Html.DisplayNameFor(model => model.Cedula)</th>
                    <th>@Html.DisplayNameFor(model => model.Nombres)</th>
                    <th>@Html.DisplayNameFor(model => model.Apellidos)</th>
                    <th>@Html.DisplayNameFor(model => model.Correo)</th>
                    <th>@Html.DisplayNameFor(model => model.Telefono)</th>
                    <th>@Html.DisplayNameFor(model => model.Ciudad)</th>
                    <th>@Html.DisplayNameFor(model => model.Activo)</th>
                    <th class="text-end pe-4">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center py-5">
                            <p class="h5 mb-2">Aún no hay clientes</p>
                            <p class="text-secondary mb-3">Registra el primer cliente para comenzar.</p>
                            <a asp-action="Create" class="btn btn-primary">Registrar cliente</a>
                        </td>
                    </tr>
                }
                @foreach (var cliente in Model)
                {
                    <tr>
                        <td class="ps-4 fw-medium">@cliente.Cedula</td>
                        <td>@cliente.Nombres</td>
                        <td>@cliente.Apellidos</td>
                        <td>@cliente.Correo</td>
                        <td>@cliente.Telefono</td>
                        <td>@cliente.Ciudad</td>
                        <td><span class="badge rounded-pill @(cliente.Activo ? "text-bg-success" : "text-bg-secondary")">@(cliente.Activo ? "Activo" : "Inactivo")</span></td>
                        <td class="text-end text-nowrap pe-4">
                            <a asp-action="Details" asp-route-id="@cliente.Id" class="btn btn-sm btn-outline-secondary">Ver</a>
                            <a asp-action="Edit" asp-route-id="@cliente.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                            <a asp-action="Delete" asp-route-id="@cliente.Id" class="btn btn-sm btn-outline-danger">Eliminar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
