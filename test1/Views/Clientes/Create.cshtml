@model test1.Models.Cliente

@{
    ViewData["Title"] = "Registrar cliente";
}

<div class="mb-4">
    <h1 class="h2 fw-bold">Registrar cliente</h1>
    <p class="text-secondary mb-0">Completa los datos para agregar una persona al directorio.</p>
</div>
<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-4 p-md-5">
        <form asp-action="Create" method="post">
            <partial name="_ClienteForm" model="Model" />
            <div class="mt-4 pt-3 border-top">
                <button type="submit" class="btn btn-primary px-4">Guardar cliente</button>
                <a asp-action="Index" class="btn btn-outline-secondary ms-2">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
